# ─────────────────────────────────────────────────────────────────────────────
# Expense Automator — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ── Backend extraction service ────────────────────────────────────────────────
# URL of the receipt-extraction micro-service endpoint
EXTRACTION_BACKEND_URL=http://localhost:8000/extract

# API key / bearer token for the extraction service (if required)
EXTRACTION_API_KEY=your_extraction_api_key_here

# ── Policy / approval engine ──────────────────────────────────────────────────
# URL of the policy-engine service that returns Auto-Approved / Denied / Review
POLICY_ENGINE_URL=http://localhost:8001/evaluate
POLICY_ENGINE_API_KEY=your_policy_engine_api_key_here

# ── Notification / messaging channel ─────────────────────────────────────────
# WebSocket or broker endpoint used to push approval messages to employees
NOTIFICATION_WS_URL=ws://localhost:8002/notify

# ── Receipt database ──────────────────────────────────────────────────────────
# Connection string for the persistent duplicate-check store
# (replaces the in-memory Pandas DataFrame in production)
RECEIPT_DB_URL=postgresql://user:password@localhost:5432/expense_automator

# ── Streamlit ─────────────────────────────────────────────────────────────────
# Override the default server port if needed
STREAMLIT_SERVER_PORT=8501

# ── General ───────────────────────────────────────────────────────────────────
APP_ENV=development   # development | staging | production
LOG_LEVEL=INFO
